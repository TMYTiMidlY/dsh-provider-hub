{
  "name": "dsh-web-search",
  "version": "0.1.0-local.4",
  "description": "Provider-selectable web_search plugin for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./tool": "./lib/tool.js",
    "./client": "./lib/client.js",
    "./typert": "./lib/typert.host.js",
    "./remote": "./lib/typert.remote-client.js",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "preset.patch.yml", "README.md", "LICENSE"],
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "npm test && node --check lib/index.js && node --check lib/tool.js && node --check lib/client.js && node --check lib/codecs.js && node --check lib/typert.host.js && node --check lib/typert.remote-client.js",
    "pack:check": "npm pack --dry-run"
  },
  "engines": { "node": ">=22" },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5-alpha.1",
    "@deepseek-ai/dsh-authorization": ">=0.2.1-alpha.1",
    "@deepseek-ai/dsh-credentials": ">=0.2.1-alpha.1",
    "@deepseek-ai/dsh-tools": ">=0.2.1-alpha.1",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.1-alpha.1",
    "@deepseek-ai/dsh-web": ">=0.2.1-alpha.1"
  },
  "dsh": {
    "bundle": { "patch": ["./cordis.patch.yml", "./preset.patch.yml"] },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-api-remotes", "@deepseek-ai/dsh-client-ui-settings-models"],
      "external": ["react"]
    }
  }
}
